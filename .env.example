# Copy to .env and fill in locally. Never commit .env.
# Environment variables override values in .env.

# Claude API key. Leave empty until configured; Core starts without it.
ANTHROPIC_API_KEY=
# Default Claude model.
ANTHROPIC_MODEL=claude-opus-5-5
# Local model via llama-swap (ADR-040). Direct only: never point the URL at LiteLLM
# or Langfuse, they log full prompts. Default URL is loopback.
LLAMA_SWAP_URL=http://127.0.0.1:9292
# The llama-swap model name (alias). Empty: the llama-swap provider is off.
LLAMA_SWAP_MODEL=
# The llama-swap API key, if it requires one.
LLAMA_SWAP_API_KEY=
# Ollama is off by default (ADR-040). Set to true to use it as a fallback.
AETHER_OLLAMA_ENABLED=
# Ollama base URL (http or https).
OLLAMA_HOST=http://localhost:11434
# Only for a deliberately trusted OLLAMA_HOST that is not localhost or a private/link-local
# IP (e.g. a private overlay network): lets it receive Sensitive data, and lifts the
# off-network rules (no allow_cloud needed, no content tripwire; ADR-032). Off by
# default (docs/05 §7.1, ADR-023). Set to true to opt in.
AETHER_OLLAMA_TRUST_HOST=
# Default local model (must be pulled: ollama pull <name>).
OLLAMA_MODEL=llama3.1:8b
# Optional lower memory limits for Ollama calls, for a small local model (ADR-024 D9):
# records (1-20) and characters (1-4000) per call. Empty: 20 and 4000.
AETHER_OLLAMA_MEMORY_MAX_RECORDS=
AETHER_OLLAMA_MEMORY_MAX_CHARS=
# Bearer token for every API route except /health (ADR-021). At least 32 characters,
# e.g. `openssl rand -hex 32`. Without it Core serves only /health.
AETHER_API_TOKEN=
# DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
LOG_LEVEL=INFO
# Postgres (docker-compose.yml, ADR-020). Generate once, e.g. 48 hex characters
# (README). Passwords need at least 8 characters; only hex/alphanumerics avoid
# URL escaping.
# Owner role, set when the data volume is first created.
POSTGRES_PASSWORD=
# After moving to the encrypted volume (docs/runbooks/encrypted-volume.md,
# stage 5), add this line (uncommented) so every `docker compose` uses it:
# COMPOSE_FILE=docker-compose.yml:compose.vault.yaml
# Owner role, for migrations only (alembic). Same password as POSTGRES_PASSWORD:
# postgresql+asyncpg://aether:<owner password>@127.0.0.1:5432/aether
DATABASE_MIGRATION_URL=
# App role that Core connects as (migration 0003), with its own password, set
# with `uv run python -m core.db_admin set-app-password`. Core refuses the owner.
# postgresql+asyncpg://aether_app:<app password>@127.0.0.1:5432/aether
DATABASE_URL=
# Folder for database backups (core.backup, ADR-025). Default when empty:
# ~/.local/share/aether/backups. Must be outside this repository and private
# (mode 700). Never a cloud-synced folder. Not encrypted at rest until you move
# to the encrypted volume (docs/runbooks/encrypted-volume.md); then set it to
# ~/.local/share/aether/vault/backups.
AETHER_BACKUP_DIR=
# Output token cap for cloud model calls only (default 4096; thinking counts toward it).
# Whole number from 1 to 32000. Leave empty for the default.
AETHER_CLOUD_MAX_OUTPUT_TOKENS=
