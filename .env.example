# Copy to .env and fill in locally. Never commit .env.
# Environment variables override values in .env.

# Claude API key. Leave empty until configured; Core starts without it.
ANTHROPIC_API_KEY=
# Default Claude model.
ANTHROPIC_MODEL=claude-opus-5-5
# Ollama base URL (http or https).
OLLAMA_HOST=http://localhost:11434
# Default local model (must be pulled: ollama pull <name>).
OLLAMA_MODEL=llama3.1:8b
# Bearer token for every API route except /health (ADR-021). At least 32 characters,
# e.g. `openssl rand -hex 32`. Without it Core serves only /health.
AETHER_API_TOKEN=
# DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
LOG_LEVEL=INFO
# Postgres (docker-compose.yml, ADR-020). Generate once, e.g. 48 hex characters.
# The same password goes in both lines. Only hex/alphanumerics avoid URL escaping.
POSTGRES_PASSWORD=
# postgresql+asyncpg://aether:<password>@127.0.0.1:5432/aether
DATABASE_URL=
# Output token cap for cloud model calls only (default 4096; thinking counts toward it).
# Whole number from 1 to 32000. Leave empty for the default.
AETHER_CLOUD_MAX_OUTPUT_TOKENS=
