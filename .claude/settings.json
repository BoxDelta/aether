{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.prod.*)",
      "Read(**/.env.dev*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.prod.*)",
      "Edit(**/.env.dev*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/anthropic/**)",

      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * *:main)",
      "Bash(git push * HEAD:main)",

      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",

      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(rm -R -f*)",
      "Bash(rm -f -R*)",
      "Bash(rm --recursive --force*)",
      "Bash(rm --force --recursive*)",
      "Bash(sudo rm *)",

      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh secret*)",
      "Bash(gh auth token*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(sudo *)",

      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.pre-commit-config.yaml)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/output-styles/**)",
      "Edit(/scripts/safemerge.fish)"
    ]
  }
}
