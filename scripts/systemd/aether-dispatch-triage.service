# Template (ADR-030, #135): dispatcher dry run, posting new results to Discord.
# A systemd *user* service. Not installed by the repo. Install steps:
# dispatch/README.md. Runs from the working clone, so it runs whatever branch is
# checked out there. It reads only ~/.config/aether-dispatch/dispatch.env.
[Unit]
Description=AETHER dispatcher dry-run triage (posts to Discord)
Documentation=https://github.com/BoxDelta/aether/blob/main/dispatch/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/aether
# uv is usually in ~/.local/bin; nvidia-smi is in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env uv run python -m dispatch triage --notify
# Reports and state it writes are private.
UMask=0077
NoNewPrivileges=yes
Nice=10
# A run waits up to 5 minutes for the GPU per issue; stop a stuck run well before
# the next timer firing would pile up.
TimeoutStartSec=14min
