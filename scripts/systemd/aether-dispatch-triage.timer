# Template (ADR-030, #135): runs aether-dispatch-triage.service every 15 minutes.
# Not installed by the repo. Install steps: dispatch/README.md.
[Unit]
Description=AETHER dispatcher dry-run triage every 15 minutes

[Timer]
OnCalendar=*:0/15
# Missed while the PC was off or you were logged out: run at the next chance.
Persistent=true

[Install]
WantedBy=timers.target
